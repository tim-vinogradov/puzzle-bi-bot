# Скопируйте этот файл в .env и поменяйте нужные строки. Все параметры необязательны.

# --- База данных ---
# Пусто = встроенная SQLite, собирается из CSV кейса в папке data/ при первом запуске.
# PostgreSQL (после «python -m app.loader --postgres ...»):
# DATABASE_URL=postgresql+psycopg2://bi_reader:bi_reader_pwd@localhost:5432/puzzle

# --- Понимание запросов ---
# rules  — только встроенные правила (работает без интернета и ключей)
# hybrid — правила, а непонятное — в языковую модель (по умолчанию)
# llm    — всё через языковую модель, правила как запасной вариант
NLU_MODE=hybrid

# Языковая модель (необязательно). Вариант 1 — любой OpenAI-совместимый API:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
#   Для YandexGPT: LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1, LLM_MODEL=gpt://<folder_id>/yandexgpt/latest
#   Для локальной Ollama: LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=qwen2.5:7b

# Вариант 2 — GigaChat (ключ авторизации из личного кабинета developers.sber.ru):
# LLM_PROVIDER=gigachat
# GIGACHAT_AUTH_KEY=...
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat-2-Max
# GIGACHAT_VERIFY_SSL=false

# --- Ограничения ---
# QUERY_TIMEOUT_SEC=20     # SQL дольше — останавливается
# CALC_TIMEOUT_SEC=10      # вычисление дольше — останавливается
# MAX_ROWS=400000          # максимум строк из базы

# «Сегодня» для относительных периодов. Пусто — последняя дата продаж в базе.
# ANCHOR_DATE=2026-09-30

# --- Сервер ---
# HOST=127.0.0.1
# PORT=8000
